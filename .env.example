# Locally: copy this file to .env and fill in the values. Never commit it.
# On the server the same settings live in /opt/jhola/.env.production.local (see deploy/README.md).

# Public address of the site, used in link previews. Read at build time.
# Server: https://jhola.ramiyer.tech. Leave empty locally (defaults to http://localhost:3000).
SITE_URL=

# LLM (server only, never sent to the browser)
# Every call goes to gpt-5.4-mini through OpenRouter (openrouter.ai → Keys). Only its key is needed.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.4-mini
# Optional: call OpenAI directly instead (LLM_PROVIDER=openai, platform.openai.com → API keys).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional: how long one model call may take, in ms (default 12000).
# LLM_TIMEOUT_MS=12000
# Optional tuning (defaults shown): reasoning effort per call.
# LLM_PLAN_EFFORT=none
# LLM_CART_EFFORT=none
# LLM_REPAIR_EFFORT=none
# Optional, direct OpenAI only: its faster, pricier tier (e.g. priority; unset = standard).
# LLM_SERVICE_TIER=priority

# Rate limits and the 30-day answer cache (Upstash Redis). Without them: no limits, no cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_HOUR=10
DAILY_REQUEST_CAP=300

# The shopping agent (/api/chat) turns per person per hour, and for the whole site per day. Taps that
# re-solve the cart without a model call (/api/solve) have their own, much higher limits.
# CHAT_RATE_LIMIT_PER_HOUR=40
# CHAT_DAILY_CAP=800
# Optional: reasoning effort for the agent's model calls (none or low; default none).
# LLM_CHAT_EFFORT=none
# Optional: set to 0 to turn off streaming of the model's tool calls (on by default).
# LLM_STREAM=1

# Rate limits are off when running locally (npm run dev). Set to 1 to test them locally.
# RATE_LIMIT_IN_DEV=1

# Optional: Postgres for the request log (every build and agent turn, their carts and model calls),
# which /history and /stats read. Without it, requests are kept in memory until the server restarts.
# On the server, deploy/server/setup-postgres.sh fills in both of these.
DATABASE_URL=
# Key for counting daily visitors without storing addresses (any long random string).
VISITOR_SECRET=
# Only for running the Postgres tests locally (CI has its own): a throwaway database.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# On the live site, /history (recent builds and their cost) only opens with ?key=<this value>.
# Leave empty to keep it closed.
HISTORY_KEY=
