# Locally: copy this file to .env.local and fill in the values. Never commit it.
# On the server the same settings live in /opt/jhola/.env.production.local (see deploy/README.md).

# Public address of the site, used in link previews. Read at build time.
# Server: https://jhola.ramiyer.tech. Leave empty locally (defaults to http://localhost:3000).
SITE_URL=

# LLM (server only, never sent to the browser)
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4-mini
# Optional tuning (defaults shown): reasoning effort per call, and OpenAI's faster, pricier tier
# LLM_PLAN_EFFORT=none
# LLM_CART_EFFORT=none
# LLM_REPAIR_EFFORT=none
# LLM_SERVICE_TIER=priority

# Rate limiting and optional response cache (Upstash Redis, Step 4)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_HOUR=10
DAILY_REQUEST_CAP=300

# Rate limits are off when running locally (npm run dev). Set to 1 to test them locally.
# RATE_LIMIT_IN_DEV=1

# On the live site, /history (all generations and their cost) only opens with ?key=<this value>.
# Leave empty to keep it closed.
HISTORY_KEY=
