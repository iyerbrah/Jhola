{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "export PATH=\"$HOME/.local/node/bin:$PATH\"; npm run dev"],
      "port": 3000
    },
    {
      "name": "prod",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "export PATH=\"$HOME/.local/node/bin:$PATH\"; npm run build && npm run start -- -p 3001"],
      "port": 3001
    }
  ]
}
